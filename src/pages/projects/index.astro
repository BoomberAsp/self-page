---
import BaseLayout from '../../components/astro/BaseLayout.astro';

const projects = [
  {
    href: 'https://bot.oneweblog.cn',
    title: 'Roxy',
    link: 'bot.oneweblog.cn',
    desc: '会记住你的 QQ 智能助手。',
    tags: ['QQ Bot', 'LLM', 'Agent'],
  },
  {
    href: 'https://github.com/BoomberAsp',
    title: 'GitHub',
    link: 'github.com/BoomberAsp',
    desc: '开源项目与代码：QQ 机器人 Agent、LLM 应用、量化投资策略等。',
    tags: ['开源', 'Python', 'TypeScript'],
  },
];
---

<BaseLayout title="项目" description="参与的作品与产品">
  <h1 class="text-[1.75rem] font-bold text-[var(--heading)] tracking-tight mb-6">项目</h1>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {projects.map((p) => (
      <a
        href={p.href}
        target="_blank"
        rel="noopener noreferrer"
        class="card block p-6 no-underline group"
      >
        <div class="flex items-start justify-between gap-2">
          <div class="min-w-0">
            <h2 class="font-semibold text-[var(--heading)] group-hover:text-[var(--primary)] transition-colors">
              {p.title}
            </h2>
            <p class="text-xs text-[var(--text-tertiary)] mt-0.5">{p.link}</p>
          </div>
          <svg
            class="w-4 h-4 shrink-0 mt-1 text-[var(--text-tertiary)] group-hover:text-[var(--primary)] transition-colors"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M7 17L17 7" />
            <path d="M7 7h10v10" />
          </svg>
        </div>
        <p class="text-sm text-[var(--text-secondary)] mt-3">{p.desc}</p>
        <div class="flex flex-wrap gap-2 mt-4">
          {p.tags.map((t) => (
            <span class="chip">{t}</span>
          ))}
        </div>
      </a>
    ))}
  </div>
</BaseLayout>
