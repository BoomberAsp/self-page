---
import BaseLayout from '../../components/astro/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const PAGE_SIZE = 8;
  const allPosts = (await getCollection('posts', ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  const totalPages = Math.ceil(allPosts.length / PAGE_SIZE);
  return Array.from({ length: totalPages - 1 }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const { page } = Astro.params;
const pageNum = Number(page);

const PAGE_SIZE = 8;
const allPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const totalPages = Math.ceil(allPosts.length / PAGE_SIZE);

if (pageNum < 2 || pageNum > totalPages) return Astro.redirect('/404');

const posts = allPosts.slice((pageNum - 1) * PAGE_SIZE, pageNum * PAGE_SIZE);
---

<BaseLayout title={`博文 — 第 ${pageNum} 页`}>
  <h1 class="text-4xl lg:text-5xl font-bold text-[var(--heading)] tracking-tight mb-8">
    博文
    <span class="text-lg text-[var(--text-tertiary)] ml-3 font-normal">第 {pageNum} 页</span>
  </h1>

  <div class="space-y-3">
    {posts.map((post) => (
      <a href={`/posts/${post.id}`} class="card block px-6 py-5 no-underline">
        <h2 class="text-xl font-semibold text-[var(--heading)] mb-1.5">{post.data.title}</h2>
        {post.data.summary && (
          <p class="text-[var(--text-secondary)] line-clamp-2 mb-3">{post.data.summary}</p>
        )}
        <div class="flex flex-wrap items-center gap-2">
          {post.data.tags.map((t) => (
            <span class="chip">{t}</span>
          ))}
          <time datetime={post.data.date.toISOString()} class="text-xs text-[var(--text-tertiary)]">
            {post.data.date.toLocaleDateString('zh-CN')}
          </time>
        </div>
      </a>
    ))}
  </div>

  <nav class="flex items-center justify-center gap-2 mt-12">
    <a
      href={pageNum === 2 ? '/posts' : `/posts/${pageNum - 1}`}
      class="px-3 py-1.5 rounded-lg text-sm text-[var(--text-secondary)] hover:bg-[var(--border-light)] transition-colors no-underline"
    >
      ← 上一页
    </a>
    <span class="px-3 py-2 text-sm text-[var(--text-tertiary)]">第 {pageNum} 页 / 共 {totalPages} 页</span>
    {pageNum < totalPages && (
      <a
        href={`/posts/${pageNum + 1}`}
        class="px-3 py-1.5 rounded-lg text-sm text-[var(--text-secondary)] hover:bg-[var(--border-light)] transition-colors no-underline"
      >
        下一页 →
      </a>
    )}
  </nav>
</BaseLayout>