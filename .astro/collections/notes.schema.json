{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "string"
    },
    "type": {
      "default": "markdown",
      "type": "string",
      "enum": [
        "markdown",
        "pdf"
      ]
    },
    "pdf_file": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "date"
  ]
}